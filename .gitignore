Weather vids/

# Frontend build + deps (Lovable frontend has its own .gitignore too)
Lovable frontend/node_modules/
Lovable frontend/dist/
Lovable frontend/.output/

# Env / secrets
.env
*.local

# Internal-only docs
docs/LOVABLE_PROMPT.md
docs/PPT_GUIDE.md

# local clone of the HF Space (not part of this repo)
hf-space/
