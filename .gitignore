venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Generated / large data (rebuildable from scripts)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# precomputed SHAP factor tables served by /api/factors (needed at deploy time)
!data/processed/cloudburst_factor_impact.csv
!data/processed/district_flood_factor_impact.csv
!data/processed/satellite_flood_factor_impact.csv
!data/processed/flood_factors_factor_impact.csv
models/*.pkl
models/*.h5
reports/*.png

# Runtime artifacts the deployed API loads — kept despite the broad ignores above
!models/district_flood_model.pkl
!models/district_flood_model_calibrated.pkl
!models/satellite_flood_model.pkl
!models/cloudburst_model.pkl
!data/raw/district_flood_dataset.csv
!data/raw/satellite_flood_dataset.csv
!data/raw/cloudburst_dataset.csv

